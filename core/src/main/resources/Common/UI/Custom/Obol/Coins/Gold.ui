// One tier of coins drawn into another mod's page by ObolUi (the API):
// the count, then the coin, the same sizes as the balance pill of the HUD
// so that an amount looks the same everywhere. Appended into the row
// ObolUi puts in the caller's group; the count is set through
// "#Gold #Count.Text", and its column, sized for two digits, is widened
// through "#Gold #Count.Anchor" when there are more. TextColor is
// Denomination.GOLD.color().
@Count = (FontSize: 22, TextColor: #FFD700, RenderBold: true, HorizontalAlignment: End, VerticalAlignment: Center);

Group #Gold {
  LayoutMode: Left;

  Label #Count {
    Text: "0";
    Anchor: (Width: 30);
    Style: @Count;
  }

  Group {
    Background: (TexturePath: "../Gold.png");
    Anchor: (Width: 24, Height: 24, Left: 3, Right: 8);
  }
}
