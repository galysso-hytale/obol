// One tier of the balance pill: the count, then the coin. Appended into the
// pill by CoinsHud for each tier that has coins; the count is set through
// "#Silver #Count.Text". TextColor is Denomination.SILVER.color().
Group #Silver {
  LayoutMode: Left;

  Label #Count {
    Text: "0";
    Style: (FontSize: 22, TextColor: #C0C0C0, RenderBold: true, VerticalAlignment: Center);
  }

  Group {
    Background: "Silver.png";
    Anchor: (Width: 24, Height: 24, Left: 3, Right: 8);
  }
}
