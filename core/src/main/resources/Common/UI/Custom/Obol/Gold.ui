// One tier of the balance pill: the count, then the coin. Appended into the
// pill by CoinsHud for each tier shown; the count is set through
// "#Gold #Count.Text". The count sits right-aligned in a column sized for
// two digits, so the icons never shift with the digits (tabular figures).
// TextColor is Denomination.GOLD.color().
Group #Gold {
  LayoutMode: Left;

  Label #Count {
    Text: "0";
    Anchor: (Width: 30);
    Style: (FontSize: 22, TextColor: #FFD700, RenderBold: true, HorizontalAlignment: End, VerticalAlignment: Center);
  }

  Group {
    Background: "Gold.png";
    Anchor: (Width: 24, Height: 24, Left: 3, Right: 8);
  }
}
