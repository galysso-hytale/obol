// One tier of coins drawn into another mod's page by ObolUi (the API):
// the count, then the coin, the same sizes as the balance pill of the HUD
// so that an amount looks the same everywhere. Appended into the row
// ObolUi puts in the caller's group; the count is set through
// "#Mythril #Count.Text", and its column, sized for two digits, is widened
// through "#Mythril #Count.Anchor" when there are more. A row drawn for a
// smaller line of text (CoinsStyle.fontSize) has "#Count.Style.FontSize"
// and the anchors of "#Count" and "#Coin" scaled down. TextColor is
// Denomination.MYTHRIL.color().
@Count = (FontSize: 22, TextColor: #7FDBFF, RenderBold: true, HorizontalAlignment: End, VerticalAlignment: Center);

Group #Mythril {
  LayoutMode: Left;

  Label #Count {
    Text: "0";
    Anchor: (Width: 30);
    Style: @Count;
  }

  Group #Coin {
    Background: (TexturePath: "../Mythril.png");
    Anchor: (Width: 24, Height: 24, Left: 3, Right: 8);
  }
}
