// One tier of the balance pill: the count, then the coin. Appended into the
// pill by CoinsHud for each tier shown; the count is set through
// "#Mythril #Count.Text". The count sits right-aligned in a column sized for
// two digits, so the icons never shift with the digits (tabular figures).
// TextColor of @Normal is Denomination.MYTHRIL.color(). @Up and @Down are
// the styles CoinsHud switches the count to while the amount is rolling
// towards a gain or a loss ("#Mythril #Count.Style"), tinted so that the
// direction can be read even when the digits go by too fast.
@Normal = (FontSize: 22, TextColor: #7FDBFF, RenderBold: true, HorizontalAlignment: End, VerticalAlignment: Center);
@Up = (...@Normal, TextColor: #8CFF8C);
@Down = (...@Normal, TextColor: #FF7A7A);

Group #Mythril {
  LayoutMode: Left;

  Label #Count {
    Text: "0";
    Anchor: (MinWidth: 30);
    Style: @Normal;
  }

  Group {
    Background: "Mythril.png";
    Anchor: (Width: 24, Height: 24, Left: 3, Right: 8);
  }
}
