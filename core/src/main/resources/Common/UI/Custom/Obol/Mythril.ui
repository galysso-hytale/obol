// One tier of the balance pill: the count, then the coin. Appended into the
// pill by CoinsHud for each tier that has coins; the count is set through
// "#Mythril #Count.Text". TextColor is Denomination.MYTHRIL.color().
Group #Mythril {
  LayoutMode: Left;

  Label #Count {
    Text: "0";
    Style: (FontSize: 22, TextColor: #7FDBFF, RenderBold: true, VerticalAlignment: Center);
  }

  Group {
    Background: "Mythril.png";
    Anchor: (Width: 24, Height: 24, Left: 3, Right: 8);
  }
}
