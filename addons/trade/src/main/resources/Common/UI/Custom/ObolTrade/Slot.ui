// One cell of a grid of the trade page (Trade.ui), appended by the server
// once per slot of the container behind the grid: the slot background, a
// button over it, the stack when there is one, and its quantity as a
// label of ours (#Count), as the game's DroppedItemSlot.ui does, so that
// it can draw over the backpack mark, which the ItemSlot's own quantity
// could not: that one is part of the element, under anything drawn
// after it. The server sets "#Item.Visible", "#Item.ItemId",
// "#Count.Visible" and "#Count.Text", binds #Cell (Activating and
// RightClicking) on the player's own grids, and disables it on the
// other's offer.
//
// Three marks sit on the slot background. #Zone, the slot's own shape
// in the offer's yellow (OfferSlotBackground.png, composed by
// tmp/offer_slot.py), on every cell of my offer grid: an empty cell says
// there is room in what I give, a stack covers it with its quality
// square as anywhere else. Two tell the backpack apart: #Tint, a leather
// wash under the item, on every cell of the backpack grid and on the
// offer cells whose stack came from the backpack, and #Tag, the
// inventory's backpack icon on a dark square flush with the slot's
// top-left corner, its bottom-right corner rounded (BackpackTag.png,
// composed by tmp/backpack_tag.py), on those offer cells only. The
// server shows all three. (Images on purpose: an ItemSlot would paint
// its own opaque slot behind the icon, and the client's inventory icons
// are not reachable from Common/UI/Custom.)
$C = "../Common.ui";

Group {
  Anchor: (Width: 46, Height: 46);
  Padding: (Full: 1);

  Group {
    Anchor: (Full: 0);
    Background: "../Common/BlockSelectorSlotBackground.png";

    Group #Zone {
      Anchor: (Full: 0);
      Background: "OfferSlotBackground.png";
      Visible: false;
    }

    Group #Tint {
      Anchor: (Full: 0);
      Background: #b5813f(0.28);
      Visible: false;
    }

    ItemSlotButton #Cell {
      Anchor: (Full: 0);
      LayoutMode: Full;
      Style: (
        Default: (Background: #ffffff(0)),
        Hovered: (Background: #ffffff(0.14)),
        Pressed: (Background: #ffffff(0.26)),
        Disabled: (Background: #ffffff(0)),
        Sounds: $C.@ButtonSounds
      );

      ItemSlot #Item {
        Anchor: (Full: 0);
        Visible: false;
        ShowQualityBackground: true;
        ShowQuantity: false;
      }
    }

    // After the button, so that it draws over the item (which paints a
    // full slot under itself), and outside it, so that its corner is the
    // slot background's corner whatever the button pads.
    Group #Tag {
      Anchor: (Width: 18, Height: 18, Top: 0, Left: 0);
      Background: "BackpackTag.png";
      Visible: false;
    }

    // Last, over the mark.
    Label #Count {
      Anchor: (Right: 3, Bottom: 1);
      Visible: false;
      Style: (FontSize: 14, TextColor: #e2d8d8, HorizontalAlignment: End, VerticalAlignment: End, RenderBold: true);
    }
  }
}
