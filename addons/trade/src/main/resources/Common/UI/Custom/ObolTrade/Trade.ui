// The trade page (TradePage), the same on both sides: my offer on the
// left (#Mine) with the coin rows under it, the other's on the right
// (#Theirs), my inventory below (#Storage over #Hotbar) with my backpack
// beside it (#Backpack, its column #BackpackColumn hidden when I carry
// none), then a notice line and Cancel.
//
// The five grids (#MyOffer, #TheirOffer, #Storage, #Hotbar, #Backpack)
// are groups the server fills with one Slot.ui per slot, wrapped into
// rows of nine, and keeps up to date. #Backpack has no height here: the
// server sets its Anchor from the backpack's capacity, 54 slots at most.
// Each cell is a button: a click on a stack of my grids opens #Pick, the
// quantity popup (the stack, a slider with its number field from 1 to
// the stack, Offer or Take back that many, Cancel), a right-click moves
// the whole stack, a click on a single item moves it. The server shows
// and fills the popup (#Pick.Visible, #PickTitle, #PickIcon, the Max and
// Value of #PickQuantity, #PickMove.Text) and binds #PickMove, which
// sends "#PickQuantity.Value", and #PickCancel. No ItemGrid: on a custom
// page it reports no plain click, only a drop after picking the stack up
// in hand.
//
// The coins I offer are moved with buttons, in two columns under my
// offer, what I keep and what I give, one row per tier in each ("#Mine
// #Keep #Gold #Put1" and the like, see there): the server fills the
// rows, disables the buttons that cannot apply and binds them.
//
// The server also sets #Heading, "#Theirs #Caption", the text and
// Disabled of #AcceptButton, #TheirStatus, #Notice, draws the coins
// through Obol (ObolUi.show into the rows and #TheirCoins), and binds
// #AcceptButton and #CancelButton.
$C = "../Common.ui";
$Sounds = "../Sounds.ui";

@Caption = (...$C.@DefaultLabelStyle, VerticalAlignment: Center, HorizontalAlignment: Center, RenderUppercase: true, RenderBold: true, FontSize: 13);
@Small = (...$C.@DefaultLabelStyle, VerticalAlignment: Center, TextColor: #ffffff(0.6));
// What I give is yellow: the empty cells of my offer grid (the server
// shows #Zone of Slot.ui on them, the slot's shape in that yellow, as the
// game marks its special slots by their background), the coins column
// under it on a panel with rounded corners (OfferPanel.png, a 9-patch
// composed by tmp/offer_panel.py, its Border the corner radius), and
// its caption.
@OfferPanel = (TexturePath: "OfferPanel.png", Border: 8);
@GiveColor = #ffcc00(0.85);
// The coin rows: their height, the width of one of their buttons, the gap
// between the buttons and the coins, and the gap between the two columns.
@CoinRow = 32;
@CoinButton = 50;
@Gap = 10;
@ColumnGap = 8;
// A grid: cells of 46 (Slot.ui), wrapped by the width.
@Grid = Group {
  LayoutMode: LeftCenterWrap;
};

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    // Two offer panels of nine cells (414 plus their padding) and the gap
    // between them; the inventory and backpack columns below are the
    // same nine cells wide.
    Anchor: (Width: 936);

    #Title {
      $C.@Title {
        @Text = "Trade";
      }
    }

    #Content {
      Padding: (Vertical: 16, Horizontal: 32);

      Label #Heading {
        Anchor: (Bottom: 8);
        Style: (...$C.@DefaultLabelStyle, HorizontalAlignment: Center, FontSize: 18, TextColor: #ffffff);
      }

      Group {
        LayoutMode: Left;
        Anchor: (Bottom: 8);

        // Left: what I offer, the escrow.
        Group #Mine {
          LayoutMode: Top;
          FlexWeight: 1;
          Background: (Color: #000000(0.15));
          Padding: (Full: 8);

          Label #Caption {
            Text: "Your offer";
            Anchor: (Height: 18, Bottom: 6);
            Style: @Caption;
          }

          Group {
            LayoutMode: Center;

            @Grid #MyOffer {
              Anchor: (Width: 414, Height: 138);
            }
          }

          // The coins, as the purse's two panels: on the left what I keep
          // (#Keep), on the right what I give (#Give), in the yellow of
          // the offer's cells above so that everything I part with reads
          // as one. One row per tier in each, largest first,
          // the coins packed against the buttons, which mirror each other
          // around the gap, the ones next to it: "1 >" and "10 >" in
          // #Keep push that many into the offer, "< 1" and "< 10" in
          // #Give take them back. The server fills "#Keep #Gold #Coins"
          // and "#Give #Gold #Coins", disables the buttons that cannot
          // apply and binds them.
          Group {
            LayoutMode: Left;
            Anchor: (Top: 8, Bottom: 8);

            Group #Keep {
              LayoutMode: Top;
              FlexWeight: 1;
              Padding: (Vertical: 6, Horizontal: 8);

              Label {
                Text: "You keep";
                Anchor: (Height: 16);
                Style: (...@Caption, TextColor: #ffffff(0.6));
              }

              Group #Mythril {
                LayoutMode: Left;
                Anchor: (Height: @CoinRow, Top: 4);

                Group #Coins {
                  FlexWeight: 1;
                }

                $C.@SmallSecondaryTextButton #Put10 {
                  Anchor: (Width: @CoinButton, Height: $C.@SmallButtonHeight, Left: @Gap, Right: 4);
                  Padding: (Horizontal: 4);
                  Text: "10 >";
                }

                $C.@SmallSecondaryTextButton #Put1 {
                  Anchor: (Width: @CoinButton, Height: $C.@SmallButtonHeight);
                  Padding: (Horizontal: 4);
                  Text: "1 >";
                }
              }

              Group #Gold {
                LayoutMode: Left;
                Anchor: (Height: @CoinRow, Top: 4);

                Group #Coins {
                  FlexWeight: 1;
                }

                $C.@SmallSecondaryTextButton #Put10 {
                  Anchor: (Width: @CoinButton, Height: $C.@SmallButtonHeight, Left: @Gap, Right: 4);
                  Padding: (Horizontal: 4);
                  Text: "10 >";
                }

                $C.@SmallSecondaryTextButton #Put1 {
                  Anchor: (Width: @CoinButton, Height: $C.@SmallButtonHeight);
                  Padding: (Horizontal: 4);
                  Text: "1 >";
                }
              }

              Group #Silver {
                LayoutMode: Left;
                Anchor: (Height: @CoinRow, Top: 4);

                Group #Coins {
                  FlexWeight: 1;
                }

                $C.@SmallSecondaryTextButton #Put10 {
                  Anchor: (Width: @CoinButton, Height: $C.@SmallButtonHeight, Left: @Gap, Right: 4);
                  Padding: (Horizontal: 4);
                  Text: "10 >";
                }

                $C.@SmallSecondaryTextButton #Put1 {
                  Anchor: (Width: @CoinButton, Height: $C.@SmallButtonHeight);
                  Padding: (Horizontal: 4);
                  Text: "1 >";
                }
              }

              Group #Copper {
                LayoutMode: Left;
                Anchor: (Height: @CoinRow, Top: 4);

                Group #Coins {
                  FlexWeight: 1;
                }

                $C.@SmallSecondaryTextButton #Put10 {
                  Anchor: (Width: @CoinButton, Height: $C.@SmallButtonHeight, Left: @Gap, Right: 4);
                  Padding: (Horizontal: 4);
                  Text: "10 >";
                }

                $C.@SmallSecondaryTextButton #Put1 {
                  Anchor: (Width: @CoinButton, Height: $C.@SmallButtonHeight);
                  Padding: (Horizontal: 4);
                  Text: "1 >";
                }
              }
            }

            Group {
              Anchor: (Width: @ColumnGap);
            }

            Group #Give {
              LayoutMode: Top;
              FlexWeight: 1;
              Background: @OfferPanel;
              Padding: (Vertical: 6, Horizontal: 8);

              Label {
                Text: "You give";
                Anchor: (Height: 16);
                Style: (...@Caption, TextColor: @GiveColor);
              }

              Group #Mythril {
                LayoutMode: Left;
                Anchor: (Height: @CoinRow, Top: 4);

                $C.@SmallSecondaryTextButton #Take1 {
                  Anchor: (Width: @CoinButton, Height: $C.@SmallButtonHeight, Right: 4);
                  Padding: (Horizontal: 4);
                  Text: "< 1";
                }

                $C.@SmallSecondaryTextButton #Take10 {
                  Anchor: (Width: @CoinButton, Height: $C.@SmallButtonHeight, Right: @Gap);
                  Padding: (Horizontal: 4);
                  Text: "< 10";
                }

                Group #Coins {
                  FlexWeight: 1;
                }
              }

              Group #Gold {
                LayoutMode: Left;
                Anchor: (Height: @CoinRow, Top: 4);

                $C.@SmallSecondaryTextButton #Take1 {
                  Anchor: (Width: @CoinButton, Height: $C.@SmallButtonHeight, Right: 4);
                  Padding: (Horizontal: 4);
                  Text: "< 1";
                }

                $C.@SmallSecondaryTextButton #Take10 {
                  Anchor: (Width: @CoinButton, Height: $C.@SmallButtonHeight, Right: @Gap);
                  Padding: (Horizontal: 4);
                  Text: "< 10";
                }

                Group #Coins {
                  FlexWeight: 1;
                }
              }

              Group #Silver {
                LayoutMode: Left;
                Anchor: (Height: @CoinRow, Top: 4);

                $C.@SmallSecondaryTextButton #Take1 {
                  Anchor: (Width: @CoinButton, Height: $C.@SmallButtonHeight, Right: 4);
                  Padding: (Horizontal: 4);
                  Text: "< 1";
                }

                $C.@SmallSecondaryTextButton #Take10 {
                  Anchor: (Width: @CoinButton, Height: $C.@SmallButtonHeight, Right: @Gap);
                  Padding: (Horizontal: 4);
                  Text: "< 10";
                }

                Group #Coins {
                  FlexWeight: 1;
                }
              }

              Group #Copper {
                LayoutMode: Left;
                Anchor: (Height: @CoinRow, Top: 4);

                $C.@SmallSecondaryTextButton #Take1 {
                  Anchor: (Width: @CoinButton, Height: $C.@SmallButtonHeight, Right: 4);
                  Padding: (Horizontal: 4);
                  Text: "< 1";
                }

                $C.@SmallSecondaryTextButton #Take10 {
                  Anchor: (Width: @CoinButton, Height: $C.@SmallButtonHeight, Right: @Gap);
                  Padding: (Horizontal: 4);
                  Text: "< 10";
                }

                Group #Coins {
                  FlexWeight: 1;
                }
              }
            }
          }

          $C.@TextButton #AcceptButton {
            @Sounds = $Sounds.@SaveSettings;
            Text: "Accept";
          }
        }

        Group {
          Anchor: (Width: 12);
        }

        // Right: what the other offers, read only.
        Group #Theirs {
          LayoutMode: Top;
          FlexWeight: 1;
          Background: (Color: #000000(0.15));
          Padding: (Full: 8);

          Label #Caption {
            Anchor: (Height: 18, Bottom: 6);
            Style: @Caption;
          }

          Group {
            LayoutMode: Center;

            @Grid #TheirOffer {
              Anchor: (Width: 414, Height: 138);
            }
          }

          Group {
            LayoutMode: Left;
            Anchor: (Height: 38, Top: 8);

            Label {
              Text: "Coins";
              Anchor: (Width: 48);
              Style: @Small;
            }

            Group #TheirCoins {
              FlexWeight: 1;
            }
          }

          // Fills what the coin rows take on the left, so that the status
          // sits level with Accept.
          Group {
            FlexWeight: 1;
          }

          Label #TheirStatus {
            Anchor: (Height: $C.@DefaultButtonHeight);
            Style: (...$C.@DefaultLabelStyle, HorizontalAlignment: Center, VerticalAlignment: Center, TextColor: #ffcc00);
          }
        }
      }

      // Below: my inventory, storage then hotbar as the game lays it
      // out, and my backpack beside it.
      Label {
        Text: "Click a stack to choose how many, right-click to move it whole.";
        Anchor: (Height: 16, Bottom: 6);
        Style: (...@Small, HorizontalAlignment: Center, FontSize: 12);
      }

      // Centred, so that the inventory alone sits in the middle when the
      // backpack column is hidden.
      Group {
        LayoutMode: Center;
        Anchor: (Bottom: 8);

        Group {
          LayoutMode: Top;
          Anchor: (Width: 414);

          Label {
            Text: "Your inventory";
            Anchor: (Height: 18, Bottom: 4);
            Style: @Caption;
          }

          @Grid #Storage {
            Anchor: (Width: 414, Height: 184);
          }

          @Grid #Hotbar {
            Anchor: (Width: 414, Height: 46, Top: 6);
          }
        }

        Group {
          Anchor: (Width: 12);
        }

        Group #BackpackColumn {
          LayoutMode: Top;
          Anchor: (Width: 414);

          Label {
            Text: "Your backpack";
            Anchor: (Height: 18, Bottom: 4);
            Style: @Caption;
          }

          @Grid #Backpack {
            Anchor: (Width: 414);
          }
        }
      }

      Label #Notice {
        Anchor: (Height: 20, Bottom: 6);
        Style: (...$C.@DefaultLabelStyle, HorizontalAlignment: Center, TextColor: #ffcc00);
        Visible: false;
      }

      Group {
        LayoutMode: Center;

        $C.@SecondaryTextButton #CancelButton {
          @Sounds = $Sounds.@ButtonsCancel;
          Text: "Cancel the trade";
          FlexWeight: 1;
        }
      }
    }
  }
}

$C.@BackButton {}

// The quantity popup, over everything, shown by the server on a click.
Group #Pick {
  Visible: false;
  LayoutMode: Middle;
  Background: #000000(0.45);

  Group {
    Anchor: (Width: 380);
    LayoutMode: Top;
    Background: (TexturePath: "../Common/ContainerPatch.png", Border: 23);
    Padding: (Full: 20);

    Label #PickTitle {
      Anchor: (Height: 22, Bottom: 10);
      Style: @Caption;
    }

    Group {
      LayoutMode: Left;
      Anchor: (Height: 44, Bottom: 14);

      Group {
        Anchor: (Width: 44, Height: 44, Right: 16);
        Background: "../Common/BlockSelectorSlotBackground.png";

        ItemSlot #PickIcon {
          Anchor: (Full: 0);
          ShowQualityBackground: true;
          ShowQuantity: true;
        }
      }

      Group {
        LayoutMode: Middle;
        FlexWeight: 1;

        SliderNumberField #PickQuantity {
          Anchor: (Height: 5);
          Min: 1;
          Max: 1;
          Step: 1;
          Value: 1;
          SliderStyle: $C.@DefaultSliderStyle;
          NumberFieldStyle: $C.@DefaultInputFieldStyle;
        }
      }
    }

    Group {
      LayoutMode: Left;
      Anchor: (Height: $C.@DefaultButtonHeight);

      $C.@TextButton #PickMove {
        @Sounds = $Sounds.@SaveSettings;
        FlexWeight: 1;
        Text: "Offer";
      }


      Group {
        Anchor: (Width: 12);
      }

      $C.@SecondaryTextButton #PickCancel {
        @Sounds = $Sounds.@ButtonsCancel;
        FlexWeight: 1;
        Text: "Cancel";
      }
    }
  }
}
