// The purse page, opened by a right-click with the purse in hand
// (PursePage). Two panels side by side: what the player has (#Mine), what
// the purse holds (#Purse). Each has a title, the total, and one row per
// coin tier, largest first, with two buttons that send 1 or 10 coins of
// that tier across to the other panel ("1 >" from #Mine into the purse,
// "< 1" from #Purse back). Under the panels, two buttons move everything.
// Every amount is drawn by Obol (ObolUi.show, the API): the server fills
// "#Mine #Total" with the whole balance and "#Mine #Gold #Coins" with the
// count of that tier, packed towards the buttons (start on the balance
// side, end on the purse side), disables the buttons that cannot apply,
// and binds "#Mine #Gold #Put10" and the others. The two panels share the
// content width (FlexWeight), and in each row the coins take what the
// buttons leave, so the page is filled edge to edge whatever the container
// width.
$C = "../Common.ui";
$Sounds = "../Sounds.ui";

@Caption = (...$C.@DefaultLabelStyle, VerticalAlignment: Center, HorizontalAlignment: Center, RenderUppercase: true, RenderBold: true, FontSize: 13);
@ButtonWidth = 60;
@Gap = 12;

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 568);

    #Title {
      $C.@Title {
        @Text = "Purse";
      }
    }

    #Content {
      Padding: (Vertical: 24, Horizontal: 32);

      Group {
        LayoutMode: Left;
        Anchor: (Bottom: 12);

        // Left: the player's balance, buttons sending coins to the purse.
        Group #Mine {
          LayoutMode: Top;
          FlexWeight: 1;
          Background: (Color: #000000(0.15));
          Padding: (Full: 8);

          Label {
            Text: "Your balance";
            Anchor: (Height: 18);
            Style: @Caption;
          }

          Group #Total {
            Anchor: (Height: 24, Bottom: 8);
          }

          Group #Mythril {
            LayoutMode: Left;
            Anchor: (Height: 32, Bottom: 6);

            Group #Coins {
              FlexWeight: 1;
            }

            $C.@SmallSecondaryTextButton #Put1 {
              Anchor: (Width: @ButtonWidth, Height: $C.@SmallButtonHeight, Left: @Gap, Right: 4);
              Padding: (Horizontal: 4);
              Text: "1 >";
            }

            $C.@SmallSecondaryTextButton #Put10 {
              Anchor: (Width: @ButtonWidth, Height: $C.@SmallButtonHeight);
              Padding: (Horizontal: 4);
              Text: "10 >";
            }
          }

          Group #Gold {
            LayoutMode: Left;
            Anchor: (Height: 32, Bottom: 6);

            Group #Coins {
              FlexWeight: 1;
            }

            $C.@SmallSecondaryTextButton #Put1 {
              Anchor: (Width: @ButtonWidth, Height: $C.@SmallButtonHeight, Left: @Gap, Right: 4);
              Padding: (Horizontal: 4);
              Text: "1 >";
            }

            $C.@SmallSecondaryTextButton #Put10 {
              Anchor: (Width: @ButtonWidth, Height: $C.@SmallButtonHeight);
              Padding: (Horizontal: 4);
              Text: "10 >";
            }
          }

          Group #Silver {
            LayoutMode: Left;
            Anchor: (Height: 32, Bottom: 6);

            Group #Coins {
              FlexWeight: 1;
            }

            $C.@SmallSecondaryTextButton #Put1 {
              Anchor: (Width: @ButtonWidth, Height: $C.@SmallButtonHeight, Left: @Gap, Right: 4);
              Padding: (Horizontal: 4);
              Text: "1 >";
            }

            $C.@SmallSecondaryTextButton #Put10 {
              Anchor: (Width: @ButtonWidth, Height: $C.@SmallButtonHeight);
              Padding: (Horizontal: 4);
              Text: "10 >";
            }
          }

          Group #Copper {
            LayoutMode: Left;
            Anchor: (Height: 32, Bottom: 6);

            Group #Coins {
              FlexWeight: 1;
            }

            $C.@SmallSecondaryTextButton #Put1 {
              Anchor: (Width: @ButtonWidth, Height: $C.@SmallButtonHeight, Left: @Gap, Right: 4);
              Padding: (Horizontal: 4);
              Text: "1 >";
            }

            $C.@SmallSecondaryTextButton #Put10 {
              Anchor: (Width: @ButtonWidth, Height: $C.@SmallButtonHeight);
              Padding: (Horizontal: 4);
              Text: "10 >";
            }
          }
        }

        Group {
          Anchor: (Width: 12);
        }

        // Right: the purse, buttons sending coins back.
        Group #Purse {
          LayoutMode: Top;
          FlexWeight: 1;
          Background: (Color: #000000(0.15));
          Padding: (Full: 8);

          Label {
            Text: "In the purse";
            Anchor: (Height: 18);
            Style: @Caption;
          }

          Group #Total {
            Anchor: (Height: 24, Bottom: 8);
          }

          Group #Mythril {
            LayoutMode: Left;
            Anchor: (Height: 32, Bottom: 6);

            $C.@SmallSecondaryTextButton #Take1 {
              Anchor: (Width: @ButtonWidth, Height: $C.@SmallButtonHeight, Right: 4);
              Padding: (Horizontal: 4);
              Text: "< 1";
            }

            $C.@SmallSecondaryTextButton #Take10 {
              Anchor: (Width: @ButtonWidth, Height: $C.@SmallButtonHeight, Right: @Gap);
              Padding: (Horizontal: 4);
              Text: "< 10";
            }

            Group #Coins {
              FlexWeight: 1;
            }
          }

          Group #Gold {
            LayoutMode: Left;
            Anchor: (Height: 32, Bottom: 6);

            $C.@SmallSecondaryTextButton #Take1 {
              Anchor: (Width: @ButtonWidth, Height: $C.@SmallButtonHeight, Right: 4);
              Padding: (Horizontal: 4);
              Text: "< 1";
            }

            $C.@SmallSecondaryTextButton #Take10 {
              Anchor: (Width: @ButtonWidth, Height: $C.@SmallButtonHeight, Right: @Gap);
              Padding: (Horizontal: 4);
              Text: "< 10";
            }

            Group #Coins {
              FlexWeight: 1;
            }
          }

          Group #Silver {
            LayoutMode: Left;
            Anchor: (Height: 32, Bottom: 6);

            $C.@SmallSecondaryTextButton #Take1 {
              Anchor: (Width: @ButtonWidth, Height: $C.@SmallButtonHeight, Right: 4);
              Padding: (Horizontal: 4);
              Text: "< 1";
            }

            $C.@SmallSecondaryTextButton #Take10 {
              Anchor: (Width: @ButtonWidth, Height: $C.@SmallButtonHeight, Right: @Gap);
              Padding: (Horizontal: 4);
              Text: "< 10";
            }

            Group #Coins {
              FlexWeight: 1;
            }
          }

          Group #Copper {
            LayoutMode: Left;
            Anchor: (Height: 32, Bottom: 6);

            $C.@SmallSecondaryTextButton #Take1 {
              Anchor: (Width: @ButtonWidth, Height: $C.@SmallButtonHeight, Right: 4);
              Padding: (Horizontal: 4);
              Text: "< 1";
            }

            $C.@SmallSecondaryTextButton #Take10 {
              Anchor: (Width: @ButtonWidth, Height: $C.@SmallButtonHeight, Right: @Gap);
              Padding: (Horizontal: 4);
              Text: "< 10";
            }

            Group #Coins {
              FlexWeight: 1;
            }
          }
        }
      }

      Label #Notice {
        Anchor: (Bottom: 10);
        Style: (...$C.@DefaultLabelStyle, Wrap: true, TextColor: #ffcc00);
        Visible: false;
      }

      Group {
        LayoutMode: Center;

        $C.@SecondaryTextButton #PutAllButton {
          @Anchor = (Right: 4);
          Text: "Put all in >";
          FlexWeight: 1;
        }

        $C.@SecondaryTextButton #TakeAllButton {
          @Anchor = (Left: 4);
          Text: "< Take all out";
          FlexWeight: 1;
        }
      }
    }
  }
}

$C.@BackButton {}
