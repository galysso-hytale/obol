// One tier of a coin row in the purse page: the count, then the coin, the
// image being Obol's own (Common/UI/Custom/Obol/Mythril.png, from Obol's pack).
// Appended by CoinsUi for each tier shown; the count is set through
// "#Mythril #Count.Text". TextColor is Denomination.MYTHRIL.color().
Group #Mythril {
  LayoutMode: Left;

  Label #Count {
    Text: "0";
    Style: (FontSize: 20, TextColor: #7FDBFF, RenderBold: true, VerticalAlignment: Center);
  }

  Group {
    Background: (TexturePath: "../Obol/Mythril.png");
    Anchor: (Width: 22, Height: 22, Left: 3, Right: 8);
  }
}
