// An amount as coins, laid out exactly like the HUD's balance pill: for
// each tier, largest first, the count then the coin, the count right-
// aligned in a column sized for two digits so that the coins line up the
// same way whatever the digits. Appended into a popup's #Amount by the
// server (AmountUi), which sets "#Gold #Count.Text" and removes the tiers
// at zero (a hidden group would keep its room in the row). Sizes and
// colours are those of Obol's Common/UI/Custom/Obol/<Tier>.ui.
@Count = (FontSize: 22, RenderBold: true, HorizontalAlignment: End, VerticalAlignment: Center);

Group {
  LayoutMode: Center;
  Anchor: (Height: 24);

  Group #Mythril {
    LayoutMode: Left;

    Label #Count {
      Text: "0";
      Anchor: (Width: 30);
      Style: (...@Count, TextColor: #7FDBFF);
    }

    Group {
      Background: (TexturePath: "../Obol/Mythril.png");
      Anchor: (Width: 24, Height: 24, Left: 3, Right: 8);
    }
  }

  Group #Gold {
    LayoutMode: Left;

    Label #Count {
      Text: "0";
      Anchor: (Width: 30);
      Style: (...@Count, TextColor: #FFD700);
    }

    Group {
      Background: (TexturePath: "../Obol/Gold.png");
      Anchor: (Width: 24, Height: 24, Left: 3, Right: 8);
    }
  }

  Group #Silver {
    LayoutMode: Left;

    Label #Count {
      Text: "0";
      Anchor: (Width: 30);
      Style: (...@Count, TextColor: #C0C0C0);
    }

    Group {
      Background: (TexturePath: "../Obol/Silver.png");
      Anchor: (Width: 24, Height: 24, Left: 3, Right: 8);
    }
  }

  Group #Copper {
    LayoutMode: Left;

    Label #Count {
      Text: "0";
      Anchor: (Width: 30);
      Style: (...@Count, TextColor: #B87333);
    }

    Group {
      Background: (TexturePath: "../Obol/Copper.png");
      Anchor: (Width: 24, Height: 24, Left: 3, Right: 8);
    }
  }
}
