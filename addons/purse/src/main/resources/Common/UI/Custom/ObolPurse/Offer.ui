// What the receiver of a handed purse sees (AcceptPopup). #Question and
// #Amount are set by the server.
$C = "../Common.ui";
$Sounds = "../Sounds.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 420);

    #Title {
      $C.@Title {
        @Text = "Purse";
      }
    }

    #Content {
      Padding: (Vertical: 24, Horizontal: 32);

      Label #Question {
        Anchor: (Bottom: 12);
        Style: (...$C.@DefaultLabelStyle, HorizontalAlignment: Center, Wrap: true, FontSize: 18, TextColor: #ffffff);
      }

      // Filled by the server with Obol's coins (ObolUi.show).
      Group #Amount {
        Anchor: (Height: 24, Bottom: 20);
      }

      Group {
        LayoutMode: Center;

        $C.@TextButton #AcceptButton {
          @Sounds = $Sounds.@SaveSettings;
          @Anchor = (Right: 4);
          Text: "Accept";
          FlexWeight: 1;
        }

        $C.@SecondaryTextButton #DeclineButton {
          @Sounds = $Sounds.@ButtonsCancel;
          @Anchor = (Left: 4);
          Text: "Decline";
          FlexWeight: 1;
        }
      }
    }
  }
}

$C.@BackButton {}
