// One tier of a coin row in the purse page: the count, then the coin, the
// image being Obol's own (Common/UI/Custom/Obol/Silver.png, from Obol's pack).
// Appended by CoinsUi for each tier shown; the count is set through
// "#Silver #Count.Text". TextColor is Denomination.SILVER.color().
Group #Silver {
  LayoutMode: Left;

  Label #Count {
    Text: "0";
    Style: (FontSize: 20, TextColor: #C0C0C0, RenderBold: true, VerticalAlignment: Center);
  }

  Group {
    Background: (TexturePath: "../Obol/Silver.png");
    Anchor: (Width: 22, Height: 22, Left: 3, Right: 8);
  }
}
